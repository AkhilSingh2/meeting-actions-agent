# Quorum runs in demo mode unless this is exactly "false".
# Demo mode never calls a model or a ticket API.
DEMO_MODE=true

# Optional live extraction. Leave blank in the demo.
# LLM_PROVIDER: openai | anthropic | ollama
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama speaks the OpenAI-compatible API. No key is required.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=

# Jira Cloud. One issue per action item.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# Linear. One issue per action item.
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# GitHub Issues. GITHUB_REPO is owner/name.
GITHUB_TOKEN=
GITHUB_REPO=

# Notion. The database title property defaults to "Name".
# Owner, due date, and citation are written into the page body
# so a database does not need a matching column for each field.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_TITLE_PROPERTY=Name

# Slack. One message for the meeting, not one per action.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
